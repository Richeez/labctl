#!/usr/bin/env bash

set -Eeuo pipefail


###############################################################################
# Bootstrap
###############################################################################
# source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/core" && pwd)/home.sh"
source "$(dirname "${BASH_SOURCE[0]}")/../lib/core/home.sh"
source "$LABCTL_HOME/lib/core/bootstrap.sh"

###############################################################################
# Command Loader
###############################################################################

load_command() {

    local command="$1"
    local file="$COMMAND_DIR/${command}.sh"


    ###########################################################################
    # Validate command
    ###########################################################################

    if [[ -z "$command" ]]; then

        log_error "No command specified."

        echo

        help

        return "$EXIT_INVALID_ARGUMENT"

    fi


    ###########################################################################
    # Locate command
    ###########################################################################

    if [[ ! -f "$file" ]]; then

        log_error "Unknown command: $command"

        echo

        help

        return "$EXIT_INVALID_ARGUMENT"

    fi


    ###########################################################################
    # Remove previous command handler
    #
    # Every command provides its own run() function.
    ###########################################################################

    unset -f run 2>/dev/null || true


    ###########################################################################
    # Load command
    ###########################################################################

    if ! source "$file"; then

        log_error "Failed to load command: $command"

        unset -f run 2>/dev/null || true

        return "$EXIT_FAILURE"

    fi


    ###########################################################################
    # Verify command handler
    ###########################################################################

    if ! declare -F run >/dev/null; then

        log_error "Command '$command' does not define run()."

        unset -f run 2>/dev/null || true

        return "$EXIT_CONFIGURATION_ERROR"

    fi


    ###########################################################################
    # Success
    ###########################################################################

    return "$EXIT_SUCCESS"

}

