###############################################################################
# Built-in Commands
###############################################################################

help() {
    # install_summary

#     for i in eth0 eth1 eth2 eth3; do
#     echo "$i -> $(cat /sys/class/net/$i/address)"
# done

#  SRC = source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/core" && pwd)/home.sh"
#  BOOST = source lib/core/bootstrap.sh
# echo "$SRC"
# echo "$BOOST"

cat <<EOF
LABCTL v${VERSION}

Usage:
    labctl <command>

Commands

    help        Show this help
    version     Show version
    status      Show network status
    doctor      Verify networking health
    doctor --repair
    test        Test all logics effectively
    repair

    network     Switch network mode (see: labctl network --help)
    net         Short network-mode alias; defaults to Internet/NAT
    contain     Containment mode (NAT Network; legacy shortcut)
    lab         Internal lab (legacy shortcut)
    bridged     Bridged network (legacy shortcut)

    install     Setup Labctl
    uninstall   Remove Labctl
    uninstall --purge
    update      Update Labctl
    upgrade     Update Labctl (legacy shortcut)

    cache status
    cache clear
    cache rebuild



Examples

    labctl status
    labctl doctor
    labctl network internet
    sudo labctl net
    labctl contain

EOF

}

version() {

    echo "${NAME} ${VERSION}"

}


