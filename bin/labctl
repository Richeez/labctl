main(){

local command="${1:-help}"

case "$command" in

    help|-h|--help)

        help
        ;;

    version|-v|--version)

        version
        ;;

    *)
    

        load_command "$command" || return $?

        shift || true

        run "$@"
        ;;

esac
}

main "$@"


