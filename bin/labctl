#!/usr/bin/env bash

set -Eeuo pipefail



###############################################################################
# Resolve LABCTL installation root
###############################################################################

SOURCE="${BASH_SOURCE[0]}"

while [[ -L "$SOURCE" ]]; do

    DIRECTORY="$(cd -P "$(dirname "$SOURCE")" && pwd)"

    SOURCE="$(readlink "$SOURCE")"

    [[ "$SOURCE" != /* ]] && \
        SOURCE="$DIRECTORY/$SOURCE"

done

LABCTL_BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LABCTL_HOME="$(cd "$LABCTL_BIN_DIR/.." && pwd)"

export LABCTL_HOME


###############################################################################
# Bootstrap
##############################################################################
# source "$(dirname "${BASH_SOURCE[0]}")/../lib/core/home.sh"
source "$LABCTL_HOME/lib/core/bootstrap.sh"

###############################################################################
# Command Loader
###############################################################################

load_command() {

    local command="$1"
    local file="$COMMAND_DIR/${command}.sh"


    ###########################################################################
    # Validate command
    ###########################################################################

    if [[ -z "$command" ]]; then

        log_error "No command specified."

        echo

        help

        return "$EXIT_INVALID_ARGUMENT"

    fi


    ###########################################################################
    # Locate command
    ###########################################################################

    if [[ ! -f "$file" ]]; then

        log_error "Unknown command: $command"

        echo

        help

        return "$EXIT_INVALID_ARGUMENT"

    fi


    ###########################################################################
    # Remove previous command handler
    #
    # Every command provides its own run() function.
    ###########################################################################

    unset -f run 2>/dev/null || true


    ###########################################################################
    # Load command
    ###########################################################################

    if ! source "$file"; then

        log_error "Failed to load command: $command"

        unset -f run 2>/dev/null || true

        return "$EXIT_FAILURE"

    fi


    ###########################################################################
    # Verify command handler
    ###########################################################################

    if ! declare -F run >/dev/null; then

        log_error "Command '$command' does not define run()."

        unset -f run 2>/dev/null || true

        return "$EXIT_CONFIGURATION_ERROR"

    fi


    ###########################################################################
    # Success
    ###########################################################################

    return "$EXIT_SUCCESS"

}


###############################################################################
# Built-in Commands
###############################################################################

help() {
    # install_summary

#     for i in eth0 eth1 eth2 eth3; do
#     echo "$i -> $(cat /sys/class/net/$i/address)"
# done

#  SRC = source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib/core" && pwd)/home.sh"
#  BOOST = source lib/core/bootstrap.sh
# echo "$SRC"
# echo "$BOOST"

cat <<EOF
LABCTL v${VERSION}

Usage:
    labctl <command>

Network modes (root required)

    network <mode>  Switch mode: internet, contain, lab, or bridged
    net [mode]      Network-mode alias; defaults to internet/NAT
    contain         Containment mode (legacy shortcut)
    lab             Internal lab (legacy shortcut)
    bridged         Bridged mode (legacy shortcut; confirmation required)

Operations

    status      Show network status
    doctor      Verify networking health
    doctor --repair
    repair
    cache <action> Inspect or rebuild cached state
    config <action> View or manage configuration
    inventory, discover, report, export, vm, scan

Installation (root required)

    install     Install LABCTL from this checkout (see: labctl install --help)
    uninstall   Remove LABCTL (see: labctl uninstall --help)
    update      Refresh the installed checkout (see: labctl update --help)
    upgrade     Update LABCTL (legacy shortcut)

Other

    version     Show version information
    test        Run the test suite
    help        Show this help


Examples

    labctl status
    labctl doctor
    labctl network internet
    sudo labctl net
    sudo labctl contain

EOF

}

version() {

    echo "${NAME} ${VERSION}"

}


################################################################################
# Main
###############################################################################

main(){

local command="${1:-help}"

case "$command" in

    help|-h|--help)

        help
        ;;

    version|-v|--version)

        version
        ;;

    *)
    

        load_command "$command" || return $?

        shift || true

        run "$@"
        ;;

esac
}

main "$@"